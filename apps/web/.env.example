# Leave blank in local development to use the Vite /api and /sanctum proxy.
VITE_API_ORIGIN=

# Stable canonical public web origin encoded into physical Asset QR labels.
# Production label generation must set this to the permanent LARAS HTTPS origin below.
# Canonical production value: https://laras.bakaranproject.com
VITE_PUBLIC_SCAN_ORIGIN=

# Vite development-server proxy target. This value is not a secret.
# Legacy env-key name is retained during brand migration for compatibility.
SMARTLAB_API_PROXY_TARGET=http://127.0.0.1:8000
